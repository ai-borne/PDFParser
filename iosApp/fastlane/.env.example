# Copy to iosApp/fastlane/.env (git-ignored) and fill in real values.
# Never commit .env or the .p8 key itself.

ASC_KEY_ID=YOUR_KEY_ID
ASC_ISSUER_ID=YOUR_ISSUER_ID
# Path to the downloaded App Store Connect API private key.
# Keep it outside the repo — standard location fastlane/Apple tooling looks for:
ASC_KEY_FILEPATH=~/.appstoreconnect/private_keys/AuthKey_YOUR_KEY_ID.p8
